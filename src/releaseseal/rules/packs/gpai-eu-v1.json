      "severity": "medium",
      "keywords": ["training data", "## data", "dataset description"]
    },
    {
      "id": "xi.intended_use",
      "profile": "annex_xi",
      "label": "Intended tasks / acceptable use",
      "source": "Annex XI, 1(a)",
      "severity": "medium",
      "keywords": ["intended use", "intended tasks", "## uses"]
